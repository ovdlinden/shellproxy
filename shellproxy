#!/bin/bash
# shellproxy CLI - status and management
# shellcheck disable=SC2155
set -euo pipefail

SHELLPROXY_DIR="${SHELLPROXY_DIR:-$HOME/.shellproxy}"
VERSION="1.0.0"

# Source libraries
source "$SHELLPROXY_DIR/lib/config.sh"
source "$SHELLPROXY_DIR/lib/docker.sh"

# Colors (only if terminal supports it)
if [[ -t 1 ]]; then
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    RED='\033[0;31m'
    BLUE='\033[0;34m'
    DIM='\033[0;90m'
    BOLD='\033[1m'
    NC='\033[0m' # No Color
else
    GREEN='' YELLOW='' RED='' BLUE='' DIM='' BOLD='' NC=''
fi

cmd_status() {
    if [[ -z "${SHELLPROXY_PROJECT:-}" ]]; then
        echo "Not in a Taskfile project"
        return 0
    fi

    local taskfile="$SHELLPROXY_PROJECT/Taskfile"
    local container=$(get_container "$taskfile")

    echo -e "${BOLD}Project:${NC} $SHELLPROXY_PROJECT"

    if [[ -z "$container" ]]; then
        echo -e "${BOLD}Mode:${NC}    ${BLUE}local${NC}"
    else
        local status_icon="${RED}●${NC}"
        local status_text="stopped"

        if container_running "$container"; then
            status_icon="${GREEN}●${NC}"
            status_text="running"
        fi

        echo -e "${BOLD}Mode:${NC}    ${GREEN}docker${NC}"
        echo -e "${BOLD}Container:${NC} ${container} ${status_icon} ${status_text}"

        local compose_file=$(find_compose_file "$SHELLPROXY_PROJECT" "$taskfile")
        if [[ -n "$compose_file" ]]; then
            echo -e "${BOLD}Compose:${NC} ${DIM}${compose_file}${NC}"
        fi
    fi

    if [[ "${SHELLPROXY_DISABLE:-}" == "1" ]]; then
        echo -e "\n${YELLOW}⚠ Routing is disabled for this shell${NC}"
    fi
}

cmd_info() {
    echo -e "${BOLD}shellproxy${NC} v${VERSION}"
    echo ""
    echo "Transparent command routing for Docker-based development."
    echo ""
    echo -e "${BOLD}How it works:${NC}"
    echo "  1. Shell hook detects when you cd into a Taskfile project"
    echo "  2. Commands like php, node, npm are intercepted"
    echo "  3. If a container is configured and running, commands route there"
    echo "  4. Otherwise, commands run locally (graceful fallback)"
    echo ""
    echo -e "${BOLD}Environment variables:${NC}"
    echo "  SHELLPROXY_PROJECT   Current project directory"
    echo "  SHELLPROXY_CONTAINER Current container name"
    echo "  SHELLPROXY_DISABLE   Set to 1 to disable routing"
    echo "  SHELLPROXY_DEBUG     Set to 1 for debug output"
    echo "  SHELLPROXY_VERBOSE   Set to 1 for verbose warnings"
    echo ""
    echo -e "${BOLD}Installation:${NC}"
    echo "  $SHELLPROXY_DIR"
}

cmd_debug() {
    if [[ $# -eq 0 ]]; then
        echo "Usage: shellproxy debug <command> [args...]"
        echo ""
        echo "Run a command with debug output enabled."
        echo "Example: shellproxy debug php -v"
        return 1
    fi

    export SHELLPROXY_DEBUG=1
    exec "$@"
}

cmd_on() {
    unset SHELLPROXY_DISABLE
    echo -e "${GREEN}Routing enabled${NC}"
    echo "Note: This only affects the current shell."
}

cmd_off() {
    export SHELLPROXY_DISABLE=1
    echo -e "${YELLOW}Routing disabled${NC}"
    echo "Note: This only affects the current shell."
    echo "Run 'shellproxy on' to re-enable."
}

cmd_which() {
    local target="${1:-}"

    if [[ -z "$target" ]]; then
        echo "Usage: shellproxy which <command>"
        echo ""
        echo "Show where a command would be executed."
        return 1
    fi

    # Check if we have a shim
    if [[ -x "$SHELLPROXY_DIR/bin/$target" ]]; then
        echo -e "${BOLD}Shim:${NC} $SHELLPROXY_DIR/bin/$target"
    fi

    # Check local command
    local local_cmd
    local_cmd=$(command -v "$target" 2>/dev/null || true)
    if [[ -n "$local_cmd" ]]; then
        echo -e "${BOLD}Local:${NC} $local_cmd"
    fi

    # Check container
    if [[ -n "${SHELLPROXY_PROJECT:-}" ]]; then
        local taskfile="$SHELLPROXY_PROJECT/Taskfile"
        local container=$(get_container "$taskfile")

        if [[ -n "$container" ]] && container_running "$container"; then
            local container_cmd
            container_cmd=$(docker exec "$container" which "$target" 2>/dev/null || true)
            if [[ -n "$container_cmd" ]]; then
                echo -e "${BOLD}Container ($container):${NC} $container_cmd"
            fi
        fi
    fi
}

cmd_link() {
    local target="${1:-}"

    if [[ -z "$target" ]]; then
        echo "Usage: shellproxy link <command>"
        echo ""
        echo "Create a shim for a command to enable routing."
        echo "Example: shellproxy link composer"
        return 1
    fi

    local shim_path="$SHELLPROXY_DIR/bin/$target"

    if [[ -e "$shim_path" ]]; then
        echo "Shim already exists: $shim_path"
        return 1
    fi

    ln -s "$SHELLPROXY_DIR/dispatch" "$shim_path"
    echo -e "${GREEN}Created shim:${NC} $shim_path"
}

cmd_unlink() {
    local target="${1:-}"

    if [[ -z "$target" ]]; then
        echo "Usage: shellproxy unlink <command>"
        echo ""
        echo "Remove a command shim."
        return 1
    fi

    local shim_path="$SHELLPROXY_DIR/bin/$target"

    if [[ ! -L "$shim_path" ]]; then
        echo "No shim found: $shim_path"
        return 1
    fi

    rm "$shim_path"
    echo -e "${YELLOW}Removed shim:${NC} $shim_path"
}

cmd_list() {
    echo -e "${BOLD}Active shims:${NC}"
    echo ""

    local count=0
    for shim in "$SHELLPROXY_DIR/bin/"*; do
        if [[ -L "$shim" ]]; then
            local name=$(basename "$shim")
            echo "  $name"
            ((count++))
        fi
    done

    if [[ $count -eq 0 ]]; then
        echo "  (none)"
    fi

    echo ""
    echo "Use 'shellproxy link <cmd>' to add a shim."
}

cmd_help() {
    echo -e "${BOLD}shellproxy${NC} - Transparent Docker command routing"
    echo ""
    echo -e "${BOLD}Usage:${NC}"
    echo "  shellproxy <command> [options]"
    echo ""
    echo -e "${BOLD}Commands:${NC}"
    echo "  status        Show current project and routing status"
    echo "  info          Show detailed information about shellproxy"
    echo "  on            Enable routing for this shell"
    echo "  off           Disable routing for this shell"
    echo "  which <cmd>   Show where a command would be executed"
    echo "  link <cmd>    Create a shim for a command"
    echo "  unlink <cmd>  Remove a command shim"
    echo "  list          List all active shims"
    echo "  debug <cmd>   Run a command with debug output"
    echo "  help          Show this help message"
    echo "  version       Show version"
    echo ""
    echo -e "${BOLD}Examples:${NC}"
    echo "  shellproxy status"
    echo "  shellproxy which php"
    echo "  shellproxy link composer"
    echo "  shellproxy debug php artisan migrate"
}

cmd_version() {
    echo "shellproxy v${VERSION}"
}

# Main
main() {
    local cmd="${1:-status}"
    shift 2>/dev/null || true

    case "$cmd" in
        status)  cmd_status "$@" ;;
        info)    cmd_info "$@" ;;
        debug)   cmd_debug "$@" ;;
        on)      cmd_on "$@" ;;
        off)     cmd_off "$@" ;;
        which)   cmd_which "$@" ;;
        link)    cmd_link "$@" ;;
        unlink)  cmd_unlink "$@" ;;
        list)    cmd_list "$@" ;;
        help|-h|--help) cmd_help "$@" ;;
        version|-v|--version) cmd_version "$@" ;;
        *)
            echo "Unknown command: $cmd"
            echo "Run 'shellproxy help' for usage."
            exit 1
            ;;
    esac
}

main "$@"
